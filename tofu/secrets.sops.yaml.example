# Copy to secrets.sops.yaml, fill in, then: sops --encrypt --in-place tofu/secrets.sops.yaml
# Top-level keys become environment variables via `sops exec-env`.
PROXMOX_VE_ENDPOINT: https://pve.lan:8006/
PROXMOX_VE_API_TOKEN: tofu@pve!tofu=REPLACE-WITH-TOKEN-SECRET
TF_VAR_state_passphrase: REPLACE-WITH-LONG-RANDOM-PASSPHRASE
# Cloudflare R2 state backend: an R2 API token with Object Read & Write on the state bucket only.
AWS_ACCESS_KEY_ID: REPLACE-WITH-R2-ACCESS-KEY-ID
AWS_SECRET_ACCESS_KEY: REPLACE-WITH-R2-SECRET-ACCESS-KEY
AWS_ENDPOINT_URL_S3: https://REPLACE-WITH-ACCOUNT-ID.r2.cloudflarestorage.com
